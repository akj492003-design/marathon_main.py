        if not self.aux_stack:
            while self.main_stack:
                self.aux_stack.append(self.main_stack.pop())
        return self.aux_stack.pop()

    def peek(self):
        if not self.aux_stack:
            while self.main_stack:
                self.aux_stack.append(self.main_stack.pop())
        return self.aux_stack[-1]

    def empty(self):
        return not self.main_stack and not self.aux_stack
