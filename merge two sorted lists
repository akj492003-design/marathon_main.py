class Solution(object):
    def mergeTwoLists(self, list1, list2):
        d = ListNode()      
        c = d               

        while list1 and list2:
            if list1.val <= list2.val:
                c.next = list1
                list1 = list1.next
            else:
                c.next = list2
                list2 = list2.next

            c = c.next

        if list1:
            c.next = list1
        else:
            c.next = list2

        return d.next
